# Copy to .env and fill it in yourself. Never paste keys into a chat.
# Named REVIVE_ so Claude Code never picks it up as its own key
REVIVE_ANTHROPIC_KEY=
# Long random ntfy topic; your phone subscribes to it
NTFY_TOPIC=revive-c1aae60e18d4
# Folder with nbz's raw exports (outside the repo)
DATA_PRIVATE_DIR=../data-private
# 1 = replay recorded heart-rate trace and fixtures instead of live sources
DEMO_MODE=0
